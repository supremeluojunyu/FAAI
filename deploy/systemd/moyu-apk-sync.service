[Unit]
Description=Sync latest Moyu APK from GitHub Release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=golden
WorkingDirectory=/home/golden/FAAI
Environment=PATH=/home/golden/.local/bin:/usr/bin:/bin
EnvironmentFile=-/home/golden/FAAI/config/apk-sync.env
# 依赖已安装时跳过 npm ci，避免无 /usr/bin/npm 时 203/EXEC
ExecStartPre=/bin/bash -c 'test -d /home/golden/FAAI/scripts/node_modules/qrcode || /home/golden/.local/bin/npm ci --prefix /home/golden/FAAI/scripts --omit=dev'
ExecStart=/home/golden/.local/bin/node /home/golden/FAAI/scripts/sync-apk-download.mjs
