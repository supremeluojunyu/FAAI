# systemd / 手动同步 APK 时使用 — 复制为 config/apk-sync.env
# GitHub Personal Access Token（需 repo 读权限，用于下载 Release）
GITHUB_TOKEN=

# 国内网络 GitHub API 镜像（TLS 被重置时使用，默认如下）
GITHUB_API_MIRROR=https://gh-proxy.com/https://api.github.com
GITHUB_DOWNLOAD_MIRROR=https://gh-proxy.com/https://github.com

# 若网络可直连 GitHub，可改为 direct 或删除镜像配置
# GITHUB_DOWNLOAD_MIRROR=direct
